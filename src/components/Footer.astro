---
import { LEGAL, SITE } from '../lib/site';
import { legalState } from '../lib/legal';
import { profileLinks } from '../lib/profile-links';
const year = new Date().getFullYear();
// One class string for every footer link, so the profile links look like their neighbours (#105, #157).
const linkClass = 'inline-block py-2 text-steel hover:text-lime';
const profiles = profileLinks(SITE);
// Linked only once the Impressum block is complete, the same rule that builds the page (#155).
const impressum = legalState(LEGAL).state === 'complete';
---

<footer class="rule mt-24 md:mt-32">
  <div class="wrap grid gap-8 py-10 md:grid-cols-[1fr_auto] md:items-end md:py-12">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-steel">Built with Astro + Three.js, Innsbruck</p>
      <p class="mt-2 text-sm text-steel">© {year} {SITE.name}. Static HTML, no tracking.</p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-0 font-mono text-xs uppercase tracking-[0.14em]">
      <li><a class={linkClass} href={SITE.repo}>Source</a></li>
      <li><a class={linkClass} href="/now/">Now</a></li>
      <li><a class="inline-block px-1 -mx-1 py-2 text-steel hover:text-lime" href="/cv/">CV</a></li>
      <li><a class={linkClass} href="/rss.xml">RSS</a></li>
      <li><a class={linkClass} href="/social.json">social.json</a></li>
      {profiles.map((p) => <li><a class={linkClass} href={p.href} rel="me">{p.label}</a></li>)}
      {impressum && <li><a class={linkClass} href="/impressum/">Impressum</a></li>}
    </ul>
  </div>
</footer>
