---
// "How the job ran" (#160): the shared method as a numbered list. Takes steps already resolved
// against PROCESS_STEPS (src/lib/process.ts), so a page with promises only can reuse it; a
// case study passes each step's proof from its own frontmatter.
interface Props {
  steps: readonly { id: string; title: string; promise: string; proof?: string }[];
}
const { steps } = Astro.props;
---

<section class="process" aria-labelledby="process-title">
  <h2 id="process-title" class="label mb-2"><b>How</b>{" "}the job ran</h2>
  <ol class="process-steps">
    {
      steps.map((s) => (
        <li class="process-step" data-step={s.id}>
          <h3 class="display-narrow text-xl">{s.title}</h3>
          <p class="process-promise">{s.promise}</p>
          {s.proof && <p class="process-proof">{s.proof}</p>}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .process {
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--color-paper);
  }
  .process-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
    display: grid;
    max-width: 52rem;
  }
  .process-step {
    counter-increment: step;
    position: relative;
    padding: 1.25rem 0 1.25rem 3rem;
    border-top: 1px solid var(--color-line);
  }
  .process-step:first-child {
    margin-top: 1.5rem;
  }
  .process-step:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .process-step::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 1.45rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--color-lime);
  }
  .process-promise {
    margin-top: 0.5rem;
    max-width: 62ch;
    line-height: 1.55;
  }
  .process-proof {
    margin-top: 0.5rem;
    max-width: 62ch;
    line-height: 1.55;
    color: var(--color-steel);
  }
</style>
