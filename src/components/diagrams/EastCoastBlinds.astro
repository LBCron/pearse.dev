---
import Diagram from './Diagram.astro';
import { eastCoastBlinds } from './east-coast-blinds';
import { CUTOVER_DONE } from '../../lib/east-coast-blinds';

// Drawn for the cutover state the copy describes (#203): today's live path while the
// cutover is planned, the swapped vhost with a rollback edge once it is done.
const { title, desc, wide, narrow } = eastCoastBlinds(CUTOVER_DONE);
---

<Diagram id="diagram-east-coast-blinds" title={title} desc={desc} wide={wide} narrow={narrow} />
